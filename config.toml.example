# btcpool-rs configuration
# Copy this to config.toml and adjust for your environment.
#
#   cp config.toml.example config.toml
#   # edit bitcoin_rpc settings, then:
#   cargo build --release
#   ./target/release/btcpool-rs config.toml
#
# Every value can be overridden by an environment variable named
# BTCPOOL_<SECTION>__<KEY> (double underscore between section and key) —
# useful for container platforms that configure apps through env vars:
#
#   BTCPOOL_BITCOIN_RPC__URL=http://10.0.0.5:8332
#   BTCPOOL_SV2__ENABLED=false
#
# Overrides are parsed as the type the key has in this file. For keys absent
# from the file, true/false and numbers are typed as such — wrap the value in
# double quotes to force a string (e.g. an all-numeric RPC password).

[pool]
# Address and port miners connect to
listen_addr = "0.0.0.0:3333"

# Block rewards pay the Bitcoin address in each miner's username. Configure the
# miner as BITCOIN_ADDRESS or BITCOIN_ADDRESS.worker. The address must match the
# connected node's network.

# Tag embedded in the coinbase scriptSig.
#
# Consensus limits the whole coinbase scriptSig to 100 bytes, and it also holds
# the BIP34 block height (up to 5 bytes) and the extranonce
# (extranonce1_size + extranonce2_size). The pool refuses to start if the total
# would exceed 100 — with the default 4 + 4 extranonce that leaves ~91 bytes for
# this tag, but there is no reason to use them: it only appears in the coinbase
# of a block you find.
coinbase_tag = "/btcpool-rs/"

# Optional safety assertion. The pool always detects the actual network from
# the connected node (getblockchaininfo), and miner payout addresses must be
# valid for that chain before work is issued. Setting this additionally makes
# boot fail fast if the node reports a different chain — catching a config
# pointed at the wrong node. "mainnet" | "testnet" | "testnet4" | "signet" | "regtest".
# network = "mainnet"

# Initial share difficulty assigned to new miners, overridden by a miner's own
# `mining.suggest_difficulty`. Vardiff adjusts from here and normally reaches
# the right value within the first minute, so this only has to be in the right
# neighbourhood for the hardware you expect.
#
# Rough guide (targeting 1 share every 5 seconds):
#   0.4 TH/s (Bitaxe Max)   →     ~470
#   1.2 TH/s (Bitaxe Gamma) →   ~1 400
#   6.5 TH/s                →   ~7 600
#   110 TH/s (S19)          → ~128 000
initial_difficulty = 2048

# Extranonce1 length in bytes (4 is standard; supports up to 255 miners)
extranonce1_size = 4

# Extranonce2 size advertised to SV1 miners (bytes). The Avalon Nano needs 4.
#
# extranonce1_size + extranonce2_size is the TOTAL extranonce region reserved in
# the coinbase. SV2 devices carve their requested rolling extranonce out of this
# same total (prefix = total - granted), so the total must be >= any SV2 device's
# min_extranonce_size (a NerdQAxe++ asks for 8 → 4 + 4 = 8 works). Raise the
# total (e.g. extranonce1_size = 8) only if an SV2 OpenChannel is still rejected.
extranonce2_size = 4

# Maximum number of simultaneous miner connections
max_connections = 256

# Idle connection timeout (seconds) — disconnect miners that stop responding
idle_timeout_secs = 300

# Directory where the raw hex of every found block is archived before
# submission, so a failed submitblock can be retried automatically or replayed
# by hand (`bitcoin-cli submitblock "$(cat <file>)"`). Relative paths resolve
# against the service working directory, like stats_db_path.
found_block_dir = "found-blocks"

# Confirmations before a found block is treated as final.
#
# The submitblock response is only true at the instant it is read: a block that
# wins its height can still be reorged out, and one that loses a same-height
# race can be promoted by the reorg that follows. Every found block is
# re-checked with getblockheader until it is this deep on the active chain
# (confirmed) or this deep on a branch that lost (reorged out), then reconciled
# against the counts. See pool_blocks_orphaned_total.
#
# 6 is the conventional finality threshold and takes about an hour. 100 is
# coinbase maturity — the depth at which the reward is actually spendable — at
# the cost of holding each block pending for ~17 hours. Do not set this to 1:
# a block one deep on a side branch is a routine reorg that usually resolves in
# our favour. Range 1–100.
confirmation_depth = 6

# Stop issuing work when getblocktemplate announces a "!"-prefixed rule this
# build does not implement.
#
# The pool does not mine your node's block — it discards Core's coinbase and
# builds its own, with the BIP34 height, your miner's payout output and the
# segwit commitment. BIP22/23 marks a rule with "!" precisely to say that a
# client doing that must understand the rule, and your node reports such a rule
# without erroring, leaving the call to the client. So at a soft-fork
# activation this binary predates, the choice is: stop, or keep building
# coinbases against rules it has never heard of.
#
# true (default) stops, because for a solo pool a silently-invalid block is the
# worst available outcome — it costs the whole reward and looks exactly like bad
# luck. You will see it as a 503 from /health naming the rule, a dashboard
# banner, and pool_unsupported_gbt_rules > 0.
#
# false keeps mining and only reports. The right setting once you have read the
# new rule and satisfied yourself the coinbase this pool builds still complies —
# or if you would rather take the chance than stop. Upgrading btcpool-rs is the
# real fix either way.
strict_gbt_rules = true

[sv2]
# Accept Stratum V2 (Extended Channel, Noise-encrypted) connections on the SAME
# listen_addr as SV1. The protocol is auto-detected from the first byte of each
# connection, so no separate port is needed. Point an SV2-capable miner (e.g. a
# NerdQAxe++ on AxeOS >= v1.0.37, "Stratum V2" selected) at the same host:port
# as your SV1 miners.
#
# Set to false to refuse SV2 and serve SV1 only.
enabled = true

# Persist the Noise authority key so the pool keeps the same identity across
# restarts. The base58check public key is logged at startup and shown in the
# dashboard's Connect modal; set it as the pool/authority public key on the
# miner to cryptographically verify the pool (identity pinning). Miners that
# do not pin connect exactly as before. Set to false for a fresh key each
# start (pinning miners will then refuse to connect after every restart).
persist_authority_key = true

# Where the authority secret key lives (one base58check line, created with
# owner-only permissions on first start). Relative paths resolve against the
# service working directory, like stats_db_path. Supports ~ expansion.
authority_key_file = "sv2-authority.key"

# Validity window (seconds) of the certificate signed for each connection:
# valid_from = now, not_valid_after = now + cert_validity_secs. Miners that
# verify pool identity check this window against their own clock (SRI-based
# verifiers allow 10 s of drift), so short values expose device clock skew.
# Default: one year.
cert_validity_secs = 31536000

[bitcoin_rpc]
# Bitcoin RPC endpoint (core/knots)
url = "http://127.0.0.1:8332"

# Cookie-file authentication (leave user/password empty when using cookie)
# Default location: ~/.bitcoin/.cookie
# Override with an absolute path if using a custom datadir or rpccookiefile=
cookie_path = "~/.bitcoin/.cookie"

# Uncomment to use explicit credentials instead of cookie
# user = "rpcuser"
# password = "rpcpassword"

# RPC timeout (seconds)
timeout_secs = 10

[zmq]
# ZMQ endpoint for Bitcoin Knots block/hashblock notifications
# Enable in bitcoin.conf:  zmqpubhashblock=tcp://127.0.0.1:28332
hashblock_endpoint = "tcp://127.0.0.1:28332"

# Fall back to polling if ZMQ is unavailable
poll_fallback = true
poll_interval_ms = 1000

[vardiff]
# Target number of seconds between share submissions per miner.
#
# This is the pool's only sampling rate: hashrate is estimated from share
# arrivals, so estimator noise scales as sqrt(target) — a 1-minute reading
# carries roughly 1/sqrt(60/target) relative error. Lowering it buys a steadier
# chart at the cost of more submits; raising it does the reverse. Blocks are
# unaffected either way, share difficulty being accounting rather than consensus.
target_share_time_secs = 3

# How often (seconds) a difficulty change may be considered. A miner running
# faster than target is re-evaluated early, once it has submitted the number of
# shares this interval implies. Both are minimums, not a schedule: an on-target
# miner is checked this often and left alone almost every time.
retarget_interval_secs = 100

# Deadzone. Difficulty is only changed when the newly measured optimum falls
# below deadzone_low × the assigned value or rises above deadzone_high × it, so
# the normal wobble of the estimate never reaches the miner. At the 5 s target
# above, that means difficulty is left alone while the measured share interval
# stays between roughly 3.3 s and 7.5 s.
#
# Widen the band (e.g. 0.5 / 1.333, which is what ckpool uses) for even fewer
# changes, at the cost of settling further from the target share time.
deadzone_low = 0.667
deadzone_high = 1.5

# Hard floor / ceiling on per-miner difficulty.
# The floor of 256 corresponds to ~220 GH/s at the 5 s target, so every Bitaxe
# model — Max, Ultra, Supra, Gamma, Gamma Turbo, Hex — is adjusted by vardiff
# rather than pinned to it. Lower it further only for sub-220 GH/s hardware; it
# is also the threshold every share is validated against.
# Note: for cgminer/Avalon hardware the floor is sent as minimum-difficulty at
# session start and cannot be changed without a reconnect.
min_difficulty = 256
# The ceiling covers ~3.4 PH/s at the 5 s target. Vardiff additionally never
# assigns a target harder than the current network difficulty.
max_difficulty = 4000000

# Safety clamp on how far one change may move the difficulty (10 = up to 10×).
# The deadzone and the decaying averages do the real smoothing; this only bounds
# a pathological jump.
max_retarget_factor = 10.0

[security]
# Rate-limit: max new TCP connections per IP per minute
max_connections_per_ip = 5

# Max share submissions per second per connection before banning
max_shares_per_sec = 500

# Ban duration (seconds) after policy violation
ban_duration_secs = 600

# Maximum genuinely invalid shares (bad nonce/duplicate) before disconnect (0 = disabled)
# Low-difficulty and stale shares are NOT counted — they're expected during transitions.
max_invalid_shares = 5

# JSON message size limit per line (bytes) — protects against oversized payloads
max_message_bytes = 4096

# Maximum byte length of an accepted worker/user-identity name. Bounds the
# global per-worker stats maps and Prometheus label cardinality against
# untrusted names. 128 fits a bech32m payout address plus a `.worker` suffix.
max_worker_name_len = 128

# Maximum number of DISTINCT worker identities one connection may authorize
# (SV1 mining.authorize / SV2 OpenExtendedMiningChannel). Each distinct name
# creates per-worker stats entries and Prometheus label series, so this bounds
# how much a single connection can grow them. Real miners authorize once.
# 0 = disabled.
max_authorizations_per_session = 8

[metrics]
# Prometheus metrics HTTP endpoint (empty string to disable)
prometheus_addr = "0.0.0.0:9090"

# Optional SQLite file for persisting all-time best stats across restarts.
# Leave empty or omit to disable.
stats_db_path = "pool_stats.sqlite"

[logging]
# Log level: trace | debug | info | warn | error
level = "info"

# Emit structured JSON to the log file (useful for log aggregators like Loki).
# Applies to log_dir output only — stdout, and therefore the journal, stays
# human-readable. Has no effect unless log_dir is set.
json = false

# Optional: Directory to write log files to. Logs always go to stdout — the
# systemd journal and the Docker log driver both read it from there — and this
# adds a rotating daily file alongside them (btcpool-rs.log.YYYY-MM-DD).
# Supports ~ expansion. Leave empty or omit for stdout only (the default).
log_dir = ""
